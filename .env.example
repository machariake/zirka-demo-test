# Copy this file to .env and fill in real values. Never commit .env.

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Database connection. Local development uses a SQLite file; hosting needs a
# Postgres URL (Neon, Supabase, Vercel Postgres) because a server's disk is
# wiped between requests. A postgres:// value switches the adapter by itself.
DATABASE_URI=file:./zirka.db

# Public address of the site, used in the sitemap and share previews.
# On Vercel set this to the deployed URL, e.g. https://your-project.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Uploads (hosting only) ---
# Without this, uploaded images are written to this machine's public/uploads,
# which a host cannot keep. Create a Blob store in the Vercel dashboard
# (Storage > Create > Blob) and it sets this variable for you.
BLOB_READ_WRITE_TOKEN=

# --- Email (optional) ---
# Leave SMTP_HOST empty and outgoing mail is written to the server console instead.
# Gmail/Google Workspace: host smtp.gmail.com, port 465, and an App Password
# (not your normal password): https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Where new-enquiry alerts are sent. Leave empty to turn alerts off.
NOTIFY_EMAIL=

# --- Spam protection (optional, free) ---
# Cloudflare Turnstile checks that forms are sent by people. Create both keys at
# dash.cloudflare.com → Turnstile → Add site (add your site's domain). Leave
# both empty to keep it off; the forms keep their other protections.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
